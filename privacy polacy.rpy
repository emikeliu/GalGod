# =========================================================================
# 界面定义
# =========================================================================
screen privacy_agreement_screen():
    modal True
    zorder 100

    add Solid("#000000ef")

    frame:
        xalign 0.5
        yalign 0.5
        xsize 0.95
        ysize 0.9
        background "#222222"
        padding (25, 25)

        vbox:
            spacing 20

            # 标题
            text "用户协议与隐私政策":
                font "SourceHanSansCN-Medium.otf"
                size 40
                xalign 0.5
                color "#ffffff"
                bold True

            # 文本内容区
            frame:
                background "#333333"
                xfill True
                yfill True
                padding (15, 15)

                viewport:
                    id "privacy_vp_mobile"
                    mousewheel True
                    draggable True
                    scrollbars "vertical"

                    text privacy_policy_content:
                        font "SourceHanSansCN-Medium.otf"
                        size 26
                        color "#cccccc"
                        layout "subtitle"
                        text_align 0.0

            # 按钮区
            hbox:
                xalign 0.5
                spacing 40
                yalign 1.0

                textbutton "不同意并退出":
                    action Quit(confirm=False)
                    text_font "SourceHanSansCN-Medium.otf"
                    text_size 35
                    text_color "#ff6666"
                    padding (30, 20)
                    background Frame(Solid("#442222"), 4, 4)
                    xsize 300
                    text_xalign 0.5

                textbutton "同意并继续":
                    action Return(True)
                    text_font "SourceHanSansCN-Medium.otf"
                    text_size 35
                    text_color "#66ff66"
                    padding (30, 20)
                    background Frame(Solid("#224422"), 4, 4)
                    xsize 300
                    text_xalign 0.5


# =========================================================================
# 核心逻辑
# =========================================================================
label splashscreen:
    # if renpy.variant("mobile"):
    if False:
        #  检测存档：如果玩家还没有同意过 (persistent 变量为 None 或 False)
        if not persistent.mobile_privacy_agreed:
            call screen privacy_agreement_screen
            $ persistent.mobile_privacy_agreed = True

    
    return